# ---------------------------------------------------------------------------
# Configuracion del agente de registro de proveedores
# Copiar a .env y rellenar los valores reales. El archivo .env esta ignorado.
# ---------------------------------------------------------------------------

# Ruta de la carpeta de casos y del repositorio de datos maestros.
FIXTURES_DIR=fixtures/reto-01

# Carpeta donde el agente deja evidencias, plantillas diligenciadas y logs.
OUTPUT_DIR=out

# Zona horaria para el calculo de vigencia de soportes.
TZ=America/Bogota

# Correo de recepcion (destino de las solicitudes entrantes).
CORREO_RECEPCION=recepcion@periferia-ficticia.com

# --- Envio de correo: el envio real solo ocurre tras la confirmacion humana ---
# Modo de correo: draft (solo prepara el borrador) | send (envia tras aprobar).
MAIL_MODE=draft
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Proveedor LLM (opcional) para redaccion del correo al cliente ---
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
PORT=3000